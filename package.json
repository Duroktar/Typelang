{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "typelang": "./bin/typelang.js",
    "tlc": "./bin/typelang.js"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && npm run build:cli",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --target=node18 --format=esm --packages=external --banner:js=\"#!/usr/bin/env node\" --outfile=bin/typelang.js && chmod +x bin/typelang.js bin/tlc.js",
    "cli": "tsx src/cli/index.ts",
    "tlc": "tsx src/cli/index.ts",
    "test": "tsx scripts/test_all.ts",
    "test:cli": "tsx scripts/test_cli.ts",
    "test:codegen": "tsx scripts/test_codegen.ts",
    "test:harness": "tsx scripts/test_native_harness.ts",
    "test:native": "tsx scripts/test_native_harness.ts",
    "test:bootstrap": "tsx scripts/test_bootstrap_pipeline.ts",
    "test:wasm": "tsx scripts/test_wasm.ts",
    "test:core": "tsx scripts/test_core.ts",
    "bootstrap": "tsx scripts/test_bootstrap_pipeline.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "mincraft:build": "tsx scripts/build_mincraft.ts",
    "mincraft:serve": "node mincraft/serve.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3": "^7.4.3",
    "@types/lodash": "^4.17.25",
    "@vitejs/plugin-react": "^5.0.4",
    "ariadne-ts": "^0.3.1",
    "canvas-confetti": "^1.9.4",
    "chalk": "^4.1.2",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "llvm-bindings": "^0.4.2",
    "lodash": "^4.18.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "string-format": "^2.0.0",
    "vite": "^6.2.3",
    "wabt": "^1.0.39",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
