# TypeLang LSP Configuration
# Copy this file to .env and customize values as needed

# Base URL for TypeLang documentation links shown in hover tooltips
# Default: http://localhost:3000/docs
# Examples:
#   - Local development: http://localhost:3000/docs
#   - Staging: https://docs-staging.example.com
#   - Production: https://docs.typelang.dev
TYPELANG_DOCS_URL=http://localhost:3000/docs
